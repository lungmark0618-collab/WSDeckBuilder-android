<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 卡圖與卡表線上更新 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- App 沒上架商店，自己下載 APK 給使用者裝，需要這個權限才能跳出安裝畫面 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 開啟相機即時掃朋友出示的牌組 QR 用 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".WSDeckApp"
        android:label="WS 牌組管理器"
        android:supportsRtl="true"
        android:theme="@style/Theme.WSDeck">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 朋友用系統相機（不是這個 App 內建的掃描功能）掃分享出去的牌組 QR
                 時，靠這個 scheme 直接跳轉進來——見 DeckImageExporter.Payload -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="wsdeck" android:host="import" />
            </intent-filter>
        </activity>

        <!-- 分享面板要拿得到出圖的檔案，得靠 FileProvider 換成 content:// URI；
             直接給 file:// 在 API 24 以上會被 FileUriExposedException 擋下來 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
